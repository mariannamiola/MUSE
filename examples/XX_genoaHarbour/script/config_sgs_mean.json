{
  "work_folder": "MUSE_test",
  "project_name": "XX_genoaHarbour",

  "samples": "data.csv",
  "varname": "reality",
  "units": "-",

  "geometry": {
    "name": "porto",
    "sub": "",
    "ext": "vtk"
  },

  "vario": {
    "dir": "OMNI",
    "dim": "3D"
  },

  "compute": {
    "space": "_varspace",
    "where": "_stats",
    "var": "mean",
    "units": "",
    "geom": "porto"
  },

  "columns": {
    "samples": {
      "x": "X",
      "y": "Y",
      "z": "Z",
      "value": "reality",
      "cat": false,
      "n_cat": 4
    },

    "scalarfield": {
      "x": "Field 0",
      "y": "Field 0",
      "z": "Field 0",
      "value": "Field 0",
      "cat": false,
      "n_cat": 4
    }
  },
  
  "view": {
    "plane": "XZ",
    "distance_factor": 1.5
  },  

  "output": {
    "save": true,
    "resolution": 3000,
    "dir": "_fig",
    "format": "png"
  }
}